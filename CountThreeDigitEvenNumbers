class Solution {
    public int totalNumbers(int[] digits) {
        int[] freq = new int[10];

        for (int d : digits)
            freq[d]++;

        int count = 0;

        for (int n = 100; n <= 998; n++) {
            if (n % 2 != 0)
                continue;

            int a = n / 100;
            int b = (n / 10) % 10;
            int c = n % 10;

            int[] need = new int[10];
            need[a]++;
            need[b]++;
            need[c]++;

            boolean valid = true;

            for (int i = 0; i < 10; i++) {
                if (need[i] > freq[i]) {
                    valid = false;
                    break;
                }
            }

            if (valid)
                count++;
        }

        return count;
    }
}
