class Solution {
    int side, k;
    long[] nums;

    public int maxDistance(int side, int[][] points, int k) {
        this.side = side;
        this.k = k;
        nums = new long[points.length];

        for (int i = 0; i < points.length; i++) {
            int x = points[i][0], y = points[i][1];

            if (x == 0)
                nums[i] = y;
            else if (y == side)
                nums[i] = (long) side + x;
            else if (x == side)
                nums[i] = (long) side * 3 - y;
            else
                nums[i] = (long) side * 4 - x;
        }

        Arrays.sort(nums);

        int l = 1, r = side;

        while (l < r) {
            int mid = (l + r + 1) / 2;

            if (check(mid))
                l = mid;
            else
                r = mid - 1;
        }

        return l;
    }

    boolean check(int d) {
        long perimeter = (long) side * 4;

        for (long start : nums) {
            long end = start + perimeter - d;
            long cur = start;

            boolean ok = true;

            for (int i = 1; i < k; i++) {
                int idx = lowerBound(cur + d);

                if (idx == nums.length || nums[idx] > end) {
                    ok = false;
                    break;
                }

                cur = nums[idx];
            }

            if (ok)
                return true;
        }

        return false;
    }

    int lowerBound(long target) {
        int l = 0, r = nums.length;

        while (l < r) {
            int mid = (l + r) / 2;

            if (nums[mid] < target)
                l = mid + 1;
            else
                r = mid;
        }

        return l;
    }
}
