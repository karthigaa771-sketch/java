class Solution {
    public int maxPathScore(int[][] g, int k) {
        int m=g.length,n=g[0].length,dp[][][]=new int[m][n][k+1];
        for(int[][] a:dp) for(int[] b:a) java.util.Arrays.fill(b,-1);
        int c=g[0][0]==0?0:1;
        if(c>k)return -1;
        dp[0][0][c]=g[0][0];

        for(int i=0;i<m;i++)for(int j=0;j<n;j++)for(c=0;c<=k;c++)
            if(dp[i][j][c]>=0){
                if(i+1<m){
                    int x=c+(g[i+1][j]>0?1:0);
                    if(x<=k)dp[i+1][j][x]=Math.max(dp[i+1][j][x],dp[i][j][c]+g[i+1][j]);
                }
                if(j+1<n){
                    int x=c+(g[i][j+1]>0?1:0);
                    if(x<=k)dp[i][j+1][x]=Math.max(dp[i][j+1][x],dp[i][j][c]+g[i][j+1]);
                }
            }

        int ans=-1;
        for(c=0;c<=k;c++)ans=Math.max(ans,dp[m-1][n-1][c]);
        return ans;
    }
}
