class Solution {
    public long maximumScore(int[][] grid) {
        int n=grid.length;
        if(n==1)return 0;

        long[][] s=new long[n][n+1];
        for(int j=0;j<n;j++)
            for(int i=0;i<n;i++)
                s[j][i+1]=s[j][i]+grid[i][j];

        long INF=Long.MIN_VALUE/2;
        long[][] dp=new long[n+1][n+1];

        for(long[] a:dp)
            java.util.Arrays.fill(a,INF);

        for(int i=0;i<=n;i++)dp[i][0]=0;

        for(int col=0;col<n-1;col++){
            long[][] next=new long[n+1][n+1];

            for(long[] a:next)
                java.util.Arrays.fill(a,INF);

            for(int h1=0;h1<=n;h1++){
                for(int h2=0;h2<=n;h2++){
                    if(dp[h1][h2]==INF)continue;

                    for(int hp=0;hp<=n;hp++){
                        long add=Math.max(0L,s[col][hp]-s[col][h1]);
                        next[hp][h1]=Math.max(next[hp][h1],
                            dp[h1][h2]+add);
                    }
                }
            }
            dp=next;
        }

        long ans=0;
        for(int a=0;a<=n;a++)
            for(int b=0;b<=n;b++)
                if(dp[a][b]!=INF)
                    ans=Math.max(ans,
                        dp[a][b]+Math.max(0L,s[n-1][b]-s[n-1][a]));

        return ans;
    }
}
