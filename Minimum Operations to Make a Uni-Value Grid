import java.util.*;

class Solution {
    public int minOperations(int[][] grid, int x) {
        int m = grid.length;
        int n = grid[0].length;

        int[] arr = new int[m * n];
        int k = 0;

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                arr[k++] = grid[i][j];
            }
        }

        for (int i = 0; i < arr.length; i++) {
            if ((arr[i] - arr[0]) % x != 0)
                return -1;
        }

        Arrays.sort(arr);

        int median = arr[arr.length / 2];
        int operations = 0;

        for (int num : arr) {
            operations += Math.abs(num - median) / x;
        }

        return operations;
    }
}
